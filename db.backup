--
-- Name: objects Give anon users access to JPG images in folder wadvy4_0; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Give anon users access to JPG images in folder wadvy4_0" ON storage.objects FOR INSERT WITH CHECK (((bucket_id = 'post_image'::text) AND (storage.extension(name) = 'jpg'::text) AND (lower((storage.foldername(name))[1]) = 'public'::text) AND (auth.role() = 'anon'::text)));


--
-- Name: objects Give anon users access to JPG images in folder wadvy4_1; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Give anon users access to JPG images in folder wadvy4_1" ON storage.objects FOR SELECT USING (((bucket_id = 'post_image'::text) AND (storage.extension(name) = 'jpg'::text) AND (lower((storage.foldername(name))[1]) = 'public'::text) AND (auth.role() = 'anon'::text)));


--
-- Name: objects Give anon users access to delete ; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Give anon users access to delete " ON storage.objects FOR DELETE USING (((bucket_id = 'post_image'::text) AND (auth.role() = 'anon'::text)));


--
-- Name: objects Give users authenticated access to delete folder ; Type: POLICY; Schema: storage; Owner: supabase_storage_admin
--

CREATE POLICY "Give users authenticated access to delete folder " ON storage.objects FOR DELETE USING (((bucket_id = 'post_image'::text) AND (auth.role() = 'authenticated'::text)));


